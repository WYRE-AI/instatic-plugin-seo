{
  "name": "instatic-plugin-seo",
  "version": "0.1.0",
  "private": true,
  "description": "SEO/AEO metadata plugin for the Instatic CMS — per-page meta description, canonical URL, Open Graph, Twitter cards, and JSON-LD.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WYRE-AI/instatic-plugin-seo.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.0 <1.4.0"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "build": "bun run ./.instatic/src/core/plugin-sdk/cli/index.ts build .",
    "lint": "bun run ./.instatic/src/core/plugin-sdk/cli/index.ts lint .",
    "dev": "bun run ./.instatic/src/core/plugin-sdk/cli/index.ts dev .",
    "test": "bun test",
    "typecheck": "bun run scripts/typecheck.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
